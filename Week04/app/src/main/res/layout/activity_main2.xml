<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white"
    tools:context=".MainActivity2">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/week_padding">
        <TextView android:id="@+id/labelWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/week_text_size"
            android:textColor="@color/week_blue"
            android:freezesText="true"
            android:text="@string/weight" />
        <SeekBar android:id="@+id/seekWeight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="230"
            android:progress="0"
            android:contentDescription="@string/weight" />
        <TextView android:id="@+id/textWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/week_text_size"
            android:textColor="@color/week_blue"
            android:freezesText="true"
             />
        <TextView android:id="@+id/labelHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/week_text_size"
            android:textColor="@color/week_blue"
            android:freezesText="true"
            android:text="@string/height" />
        <SeekBar android:id="@+id/seekHeight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="280"
            android:progress="0"
            android:contentDescription="@string/height" />
        <TextView android:id="@+id/textHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/week_text_size"
            android:textColor="@color/week_blue"
            android:freezesText="true"
             />
        <TextView android:id="@+id/textBmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/week_text_size"
            android:textColor="@color/week_blue"
            android:freezesText="true"
             />
    </LinearLayout>
</ScrollView>
